---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import contributors from "../../content/contributors.json";
import { Image } from "astro:assets";
import { Linkedin, Github } from "@lucide/astro";

const colors: Record<string, string> = {
  blue: "border-blue-500/20 dark:border-blue-400/30",
  red: "border-red-500/20 dark:border-red-400/30",
  yellow: "border-yellow-500/20 dark:border-yellow-400/30",
  green: "border-green-500/20 dark:border-green-400/30"
};
---

<Layout title="Contributors | GDG on Campus SJEC" description="Meet the people who built this portfolio website.">
    <Header />
    <main class="relative overflow-hidden w-full min-h-screen">
        <!-- Global background blobs -->
        <div class="absolute top-0 right-0 w-96 h-96 bg-blue-500/5 dark:bg-blue-600/10 blur-[120px] rounded-full -translate-y-1/2 translate-x-1/2 pointer-events-none select-none"></div>
        <div class="absolute bottom-0 left-0 w-96 h-96 bg-green-500/5 dark:bg-blue-500/10 blur-[120px] rounded-full translate-y-1/2 -translate-x-1/2 pointer-events-none select-none"></div>

        <section class="w-full py-24 px-6 md:px-12 lg:px-24 font-sans text-gray-900 dark:text-white relative overflow-hidden">
            <div class="max-w-7xl mx-auto relative z-10">
                <div class="text-center mb-16">
                    <h1 class="text-4xl md:text-6xl font-bold mb-4 tracking-tight">
                        Our <span class="text-blue-500 dark:text-blue-400">C</span><span class="text-red-500 dark:text-red-400">O</span><span class="text-[#FBBC04] dark:text-yellow-400">N</span><span class="text-green-500 dark:text-green-400">T</span>RIBUTORS
                    </h1>
                    <p class="text-gray-600 dark:text-gray-400 text-lg md:text-xl max-w-2xl mx-auto mt-4">
                        With deep gratitude to the brilliant developers, designers, and contributors who helped bring this portfolio to life.
                    </p>
                </div>

                <div class="relative group px-4 md:px-0">
                    <div class="flex flex-wrap justify-center gap-8 md:gap-10">
                        {contributors.map((member) => (
                            <div class="w-full sm:w-[calc(50%-1.25rem)] lg:w-[calc(20%-2.2rem)]">
                                <div class="group/card flex flex-col items-center text-center bg-gray-50 dark:bg-[#1A1D2B] border border-gray-100 dark:border-white/5 rounded-[2rem] p-6 md:p-8 transition-all duration-300 hover:shadow-2xl hover:shadow-blue-500/10 hover:-translate-y-2 h-[18rem] md:h-[20rem] relative">
                                    
                                    <!-- Circular Image -->
                                    <div class={`w-24 h-24 md:w-28 md:h-28 rounded-full overflow-hidden mb-6 border-4 shadow-lg shrink-0 mx-auto transition-transform duration-500 group-hover/card:scale-110 ${colors[member.color] || 'border-blue-500/20'}`}>
                                        <Image
                                            src={member.image}
                                            alt={member.name}
                                            class="w-full h-full object-cover"
                                            width={200}
                                            height={200}
                                        />
                                    </div>
                                    
                                    <!-- Information Section -->
                                    <div class="flex flex-col items-center w-full mb-4">
                                        <h3 class="text-lg md:text-xl font-bold text-gray-900 dark:text-white group-hover/card:text-blue-500 dark:group-hover/card:text-blue-400 transition-colors leading-tight">
                                            {member.name.split(' ')[0]} <br /> {member.name.split(' ').slice(1).join(' ')}
                                        </h3>
                                    </div>

                                    <!-- Social Links at Bottom -->
                                    <div class="mt-auto flex gap-4 relative z-10">
                                        {member.linkedin && (
                                            <a href={member.linkedin} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-all hover:scale-110">
                                                <Linkedin/>
                                            </a>
                                        )}
                                        {member.github && (
                                            <a href={member.github} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-black dark:hover:text-white transition-all hover:scale-110">
                                                <Github/>
                                            </a>
                                        )}
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>

<style>
  section {
    font-family: "Google Sans", sans-serif;
  }
</style>
